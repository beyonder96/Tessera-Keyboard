<?xml version="1.0" encoding="utf-8"?>
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="2dp"
    android:insetRight="2dp"
    android:insetTop="3dp"
    android:insetBottom="3dp">
    <selector>
        <!-- PRESSED STATE: Key sinks into chassis, contact shadow recedes -->
        <item android:state_pressed="true">
            <layer-list>
                <item android:top="1.5dp" android:bottom="0.5dp">
                    <shape android:shape="rectangle">
                        <solid android:color="?attr/stitchGlowColor" />
                        <corners android:radius="8dp" />
                        <stroke android:width="1dp" android:color="#40FFFFFF" />
                    </shape>
                </item>
            </layer-list>
        </item>

        <!-- NORMAL STATE: 3D Haute-Horlogerie sculpted keycap -->
        <item>
            <layer-list>
                <!-- 1. Ambient Occlusion Contact Drop Shadow -->
                <item android:top="2dp" android:bottom="0dp">
                    <shape android:shape="rectangle">
                        <solid android:color="#59000000" />
                        <corners android:radius="8dp" />
                    </shape>
                </item>
                <!-- 2. Main Tactile Keycap Body -->
                <item android:top="0dp" android:bottom="2dp">
                    <shape android:shape="rectangle">
                        <solid android:color="?attr/stitchKeyBgColor" />
                        <corners android:radius="8dp" />
                    </shape>
                </item>
                <!-- 3. Specular Top Chamfer Rim -->
                <item android:top="0dp" android:bottom="2dp">
                    <shape android:shape="rectangle">
                        <corners android:radius="8dp" />
                        <stroke android:width="1dp" android:color="#2EFFFFFF" />
                    </shape>
                </item>
            </layer-list>
        </item>
    </selector>
</inset>
